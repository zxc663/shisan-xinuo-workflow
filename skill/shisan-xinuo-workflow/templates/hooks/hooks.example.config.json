{
  "enabled": true,
  "events": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "<绝对路径>/your-hook.py",
              "SessionStart"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "<绝对路径>/your-hook.py",
              "Stop"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "<绝对路径>/top_push.example.py"
            ],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
