{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash templates/hooks/session-start.example.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash templates/hooks/session-end.example.sh"
          }
        ]
      }
    ]
  }
}
